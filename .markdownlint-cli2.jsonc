{
  "config": {
    // The design spec and the plans use long prose lines; wrapping them would make
    // diffs unreadable.
    "MD013": false,
    // Release Please writes the changelog; its heading structure is not ours to police.
    "MD024": { "siblings_only": true }
  },
  "ignores": [
    "**/node_modules/**",
    "**/build/**",
    // One changelog per release track, not just the root one: release-please writes
    // telemetry-addon/CHANGELOG.md and paper-worldpush/CHANGELOG.md too. A bare
    // "CHANGELOG.md" matches only the root file and leaves the others linted.
    "**/CHANGELOG.md"
  ]
}
