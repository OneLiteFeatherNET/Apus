# Copy to .env for local development. All values are public (client-side, SPA build) --
# never put a client secret here, this is a public OIDC client (Authorization Code + PKCE).

# The api module's base URL (see api/src/main/resources/application.yml).
NUXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Must match APUS_JWT_ISSUER on the api module -- same identity broker, same issuer.
# Which broker (Keycloak, Zitadel, ...) is still open, see design spec §15.
NUXT_PUBLIC_OIDC_ISSUER=https://id.example.net/realms/apus

# The public (no-secret) OIDC client registered for this SPA at the broker.
NUXT_PUBLIC_OIDC_CLIENT_ID=apus-ui
