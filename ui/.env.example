# Copy to apps/app/.env and/or apps/console/.env for local development -- Nuxt reads the .env
# next to the nuxt.config.ts it is starting, and this workspace has two of them. Both
# applications read exactly these three variables, with the same values: they are one OIDC
# client on one origin, differing only in base path (see ui/README.md, "Two applications, one
# OIDC client"). The deployed containers read the same variables from their environment (see
# ui/README.md, "Runtime configuration"). All values are public -- never put a client secret
# here, this is a public OIDC client (Authorization Code + PKCE).

# Where the api module is reachable -- the origin only, with no /api suffix. Every method of
# the typed client already asks for a path beginning with /api, so a suffix here produces
# /api/api/... and the API answers 403, which looks exactly like a missing role.
NUXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Must match APUS_JWT_ISSUER on the api module -- same identity broker, same issuer.
# Which broker (Keycloak, Zitadel, ...) is still open, see design spec §15.
NUXT_PUBLIC_OIDC_ISSUER=https://id.example.net/realms/apus

# The public (no-secret) OIDC client registered for this SPA at the broker.
NUXT_PUBLIC_OIDC_CLIENT_ID=apus-ui

# Which scopes to request. The default below suits a broker where the OIDC scopes alone yield an
# access token the api module accepts (Keycloak, Zitadel). Microsoft Entra does not work that way
# -- it needs the API's own scope named explicitly, or it issues a token for Microsoft Graph that
# carries none of Apus's roles:
#   NUXT_PUBLIC_OIDC_SCOPE="api://<client-id>/access_as_user openid profile email"
NUXT_PUBLIC_OIDC_SCOPE=openid profile email
