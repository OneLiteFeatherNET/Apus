.gradle/
build/
/bin/
**/bin/main/
**/bin/test/
.idea/
*.iml
runner/vendor/

# ui/ (Nuxt) -- not a Gradle module, see ui/README.md. Node dependencies and build/test
# output never belong in the repository.
ui/node_modules/
ui/.nuxt/
ui/.output/
# No trailing slash: `nuxt generate` leaves dist as a *symlink* to .output/public, and git
# matches a trailing-slash pattern against directories only -- so `ui/dist/` left the symlink
# showing up as untracked after every local build.
ui/dist
ui/coverage/
ui/.env
# Local marker @nuxt/test-utils writes recording which version last ran -- see
# vitest.nuxt.config.ts/tests/nuxt/ (added for the layout render regression test).
ui/.nuxtrc
